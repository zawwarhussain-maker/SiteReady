# ==============================================================================
# SiteReady GCC — Environment Variables & Supabase Configuration Guide
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CREDENTIALS (FRONTEND PUBLIC ACCESS)
# ------------------------------------------------------------------------------
# Obtain these values from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon public)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# ⚠️ CRITICAL SECURITY WARNING
# ------------------------------------------------------------------------------
# NEVER include SUPABASE_SERVICE_ROLE_KEY in client environment variables!
# The service-role key bypasses Row Level Security (RLS) entirely.
# All client-side requests must use the VITE_SUPABASE_ANON_KEY along with
# user JWT sessions to enforce tenant isolation.

# ------------------------------------------------------------------------------
# 2. LOCALIZATION & TIMEZONE
# ------------------------------------------------------------------------------
# Default business timezone for GCC contractor compliance (Saudi Arabia GMT+3)
VITE_DEFAULT_TIMEZONE=Asia/Riyadh
VITE_DEFAULT_LOCALE=en

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
# If VITE_SUPABASE_URL is omitted or set to placeholder, the application runs
# out-of-the-box in standalone Reactive Local DB Store mode with pre-seeded
# contractor data for Al-Fanar Contracting KSA.
VITE_APP_ENV=development
